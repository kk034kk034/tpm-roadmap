---
import '../styles/global.css';

const {
  title = 'RD to TPM Roadmap',
  description = '中文 RD 轉 TPM 的互動式技能樹、工作場景與實戰模板。'
} = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
