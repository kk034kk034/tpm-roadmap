---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoadmapFlow from '../components/RoadmapFlow';
import roadmap from '../data/roadmap.json';

const nodeCount = roadmap.branches.reduce((total, branch) => total + branch.nodes.length, 0);
---

<BaseLayout title="RD → TPM Roadmap" description="中文 RD 轉 TPM 的互動式技能樹與學習進度追蹤。">
  <main class="min-h-screen bg-paper">
    <header class="border-b border-ink/10 bg-white">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-5 py-4 lg:px-8">
        <div>
          <p class="text-sm font-bold text-moss">RD → TPM Roadmap</p>
          <h1 class="text-2xl font-black leading-tight text-ink md:text-3xl">技能地圖與學習進度</h1>
        </div>
        <div class="flex flex-wrap gap-2 text-sm font-bold">
          <span class="rounded-full bg-citron px-3 py-1.5 text-ink">{roadmap.branches.length} 大主幹</span>
          <span class="rounded-full bg-[#eef6ed] px-3 py-1.5 text-moss">{nodeCount} 節點</span>
          <a class="rounded-full border border-ink/15 px-3 py-1.5 text-ink hover:border-moss hover:text-moss" href="/search">搜尋</a>
        </div>
      </div>
    </header>

    <section id="roadmap" class="mx-auto max-w-7xl px-5 py-5 lg:px-8">
      <RoadmapFlow client:only="react" />
    </section>
  </main>
</BaseLayout>
