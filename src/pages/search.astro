---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="搜尋｜RD → TPM Roadmap">
  <main class="mx-auto min-h-screen max-w-4xl px-5 py-12">
    <a class="text-sm font-bold text-moss" href="/">← 回 Roadmap</a>
    <h1 class="mt-6 text-4xl font-black text-ink">搜尋 Roadmap</h1>
    <p class="mt-3 text-ink/70">建置後會由 Pagefind 產生全文搜尋索引。</p>
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-ui.js" is:inline></script>
    <div id="search" class="mt-8"></div>
    <script is:inline>
      window.addEventListener('DOMContentLoaded', () => {
        if (window.PagefindUI) {
          new window.PagefindUI({ element: '#search', showSubResults: true });
        }
      });
    </script>
  </main>
</BaseLayout>
