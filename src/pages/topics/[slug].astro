---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('topics');
  return pages.map((page) => ({
    params: { slug: page.id.replace(/\.mdx$/, '') },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const frontmatter = page.data;
---

<BaseLayout title={`${frontmatter.title}｜RD → TPM Roadmap`} description={frontmatter.description}>
  <main class="mx-auto grid max-w-7xl gap-8 px-5 py-10 lg:grid-cols-[240px_1fr] lg:px-8">
    <aside class="lg:sticky lg:top-6 lg:h-fit">
      <a class="text-sm font-bold text-moss" href="/">← 回 Roadmap</a>
      <div class="mt-6 rounded-lg border border-ink/12 bg-white p-4">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-ink/50">{frontmatter.level}</p>
        <h2 class="mt-2 text-xl font-bold text-ink">{frontmatter.title}</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {frontmatter.tags?.map((tag) => <span class="rounded-full bg-paper px-2.5 py-1 text-xs font-bold text-moss">{tag}</span>)}
        </div>
      </div>
    </aside>
    <article class="roadmap-prose rounded-lg border border-ink/12 bg-white px-5 py-7 shadow-panel md:px-9 md:py-10">
      <Content />
    </article>
  </main>
</BaseLayout>
