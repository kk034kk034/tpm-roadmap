---
import { sitePath } from '../../lib/paths';

// 單一主線：直接進入系統建置案，不再經過選關／隨機頁
const dest = sitePath('sims/system-build/index.html');
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${dest}`} />
    <title>進入系統建置案…</title>
    <style>
      html, body { margin: 0; background: #f4f7f4; color: #12252c; font: 700 14px/1.4 system-ui, "Noto Sans TC", sans-serif; }
      main { min-height: 100vh; display: grid; place-items: center; padding: 24px; text-align: center; }
      a { color: #2f6f5e; }
    </style>
    <script is:inline define:vars={{ dest }}>
      location.replace(dest);
    </script>
  </head>
  <body>
    <main>
      <p>正在進入系統建置案…</p>
      <p><a href={dest}>若未自動跳轉請點這裡</a> · <a href={sitePath()}>回技能地圖</a></p>
    </main>
  </body>
</html>
